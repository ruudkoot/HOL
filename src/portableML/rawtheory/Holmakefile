CLINE_OPTIONS = --no_overlay

all: $(DEFAULT_TARGETS)

theorystats.uo: theorystats.sml $(dprot $(SIGOBJ)/Graph.ui) $(dprot $(SIGOBJ)/SHA1.uo)
	$(HOLMOSMLC) -c Graph.ui $<

ifdef POLY
all: theorytool

ifeq ($(ML_SYSNAME),rune)
MKTOOL = mktool-rune.ML
EXTRA_CLEANS = theorytool.img
else
MKTOOL = mktool.ML
endif

theorytool: $(MKTOOL) theorytool.ML theorystats.uo
	$(POLYC) -o $@ $<
endif
