OPTIONS = NO_OVERLAY
EXTRA_CLEANS = unicode-grep

.PHONY: all
all: unicode-grep

ifdef POLY

ifeq ($(ML_SYSNAME),rune)
UGREP = rune-ugrep.ML
EXTRA_CLEANS += unicode-grep.img
else
UGREP = poly-ugrep.ML
endif

unicode-grep: $(UGREP) ugrep.sml
	$(POLYC) $< -o $@

else

unicode-grep: ugrep_mosml.uo ugrep.uo
	$(MOSMLC) -o $@ $<

endif
